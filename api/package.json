{
	"scripts": {
		"start": "node --env-file=.env src/index.js",
		"lint": "node scripts/lint.mjs",
		"test": "node --test \"tests/**/*.test.mjs\"",
		"quality": "pnpm run lint && pnpm run test",
		"deploy:preflight": "node --env-file=.env --env-file-if-exists=.env.production.local scripts/production-preflight.mjs --production",
		"migrate": "node --env-file=.env scripts/migrate.mjs",
		"migrate:status": "node --env-file=.env scripts/migrate.mjs --status",
		"migrate:adopt": "node --env-file=.env scripts/migrate.mjs --adopt-existing",
		"migrate:prod": "node --env-file=.env.production.local scripts/migrate.mjs",
		"migrate:status:prod": "node --env-file=.env.production.local scripts/migrate.mjs --status",
		"migrate:adopt:prod": "node --env-file=.env.production.local scripts/migrate.mjs --adopt-existing",
		"admin:bootstrap": "node --env-file=.env scripts/bootstrap-platform-admin.mjs",
		"pm2:start": "pnpm run deploy:preflight && pm2 start ecosystem.config.cjs --env production",
		"pm2:reload": "pnpm run deploy:preflight && pm2 reload ecosystem.config.cjs --env production",
		"pm2:stop": "pm2 stop crm-api",
		"pm2:delete": "pm2 delete crm-api"
	},
	"dependencies": {
		"@fastify/compress": "^8.3.1",
		"@fastify/cookie": "^10.0.1",
		"@fastify/cors": "^10.0.1",
		"@fastify/helmet": "^12.0.1",
		"@fastify/rate-limit": "^10.2.0",
		"argon2": "^0.41.1",
		"fastify": "^5.0.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.18.0"
	},
	"devDependencies": {
		"pm2": "^5.4.3"
	},
	"type": "module"
}
